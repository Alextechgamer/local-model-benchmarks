{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "probe": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "probe",
      "options": { "baseURL": "http://127.0.0.1:8099/v1", "apiKey": "none" },
      "models": { "probe": { "name": "probe", "limit": { "context": 98304, "output": 32768 },
                             "options": { "reasoningEffort": "medium" } } }
    }
  },
  "mcp": {
    "unityMCP": { "enabled": false },
    "ghidra": { "enabled": false },
    "rea": { "enabled": false }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "skill": { "*": "deny" }
  }
}
